# Editor setup for libbgraft.
CompileFlags:
  # The compilation database lives in the build tree (generated by
  # CMAKE_EXPORT_COMPILE_COMMANDS in CMakeLists.txt); debug is the
  # reference configuration.
  CompilationDatabase: build/debug
---
# Disable clangd's fast-check filter.
#
# By default (Strict) clangd runs only the subset of clang-tidy checks
# measured to be fast during its inline pass, so the editor and a
# command-line run against .clang-tidy disagree. FastCheckFilter: None
# drops the speed gating: every check enabled by .clang-tidy runs
# inline, matching the authoritative CLI results.
Diagnostics:
  ClangTidy:
    FastCheckFilter: None
